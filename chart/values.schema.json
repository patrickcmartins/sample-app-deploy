{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "versions"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^(sha-[0-9a-f]{7,40}|v[0-9]+\\.[0-9]+\\.[0-9]+)$",
          "description": "Tag imutável. 'latest' é proibido."
        }
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "weight", "replicas"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
          "replicas": { "type": "integer", "minimum": 0 },
          "tag": { "type": "string", "pattern": "^(sha-[0-9a-f]{7,40}|v[0-9]+\\.[0-9]+\\.[0-9]+)$" }
        }
      }
    }
  }
}
